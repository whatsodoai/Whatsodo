# ── Core ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database / Cache ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://whatsodo:whatsodo@localhost:5432/whatsodo
REDIS_URL=redis://localhost:6379/0

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# ── Web / CORS ───────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

# ── Email ────────────────────────────────────────────────────────────────
# EMAIL_SENDER_PROVIDER=console logs verification/reset links to stdout instead
# of sending real email — safe default until a real provider is wired up.
EMAIL_SENDER_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@whatsodo.ai
# RESEND_API_KEY=
# POSTMARK_API_KEY=

# ── Anticipated for later phases (not required yet) ─────────────────────
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=
# WHATSAPP_PHONE_NUMBER_ID=
